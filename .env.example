# ==========================================
# UniEntry Global - API Server Configuration
# ==========================================

# Port configuration
PORT=5001

# Client URL (for verification & reset link redirection)
CLIENT_URL=https://unientry.online

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_me_in_production

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=unientry
# For socket connections (XAMPP macOS default path, if applicable)
DB_SOCKET=/Applications/XAMPP/xamppfiles/var/mysql/mysql.sock

# Custom Domain SMTP Configuration (Never use Gmail in Production)
# Configure these variables on Railway or your hosting platform env vars
SMTP_HOST=mail.unientry.online
SMTP_PORT=587
SMTP_USER=noreply@unientry.online
SMTP_PASS=your_secure_smtp_password_here
SMTP_FROM=UniEntry Global <noreply@unientry.online>
